@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0 rounded-3 text-center p-4">
            <h2 class="text-primary mb-4">@ViewData["Title"]</h2>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <p class="mb-4">You are currently logged in. Click below to log out safely.</p>
                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="btn btn-danger btn-lg">Log out</button>
                </form>
            }
            else
            {
                <p class="text-success mb-0">You have successfully logged out of the application.</p>
                <a asp-page="/Index" class="btn btn-primary mt-3">Return to Home</a>
            }
        </div>
    </div>
</div>
