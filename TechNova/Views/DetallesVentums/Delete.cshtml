@model TechNova.Models.VentaDetalle
@{
    ViewData["Title"] = "Eliminar Detalle de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Eliminar Detalle de Venta</h1>

<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-danger"><i class="fa fa-exclamation-triangle"></i> ¿Está seguro que desea eliminar este detalle?</h5>

                <dl class="row mt-3">
                    <dt class="col-sm-4">Cantidad:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Cantidad)</dd>

                    <dt class="col-sm-4">Precio Unitario:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

                    <dt class="col-sm-4">Subtotal:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Subtotal)</dd>

                    <dt class="col-sm-4">Producto:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Producto.Id)</dd>

                    <dt class="col-sm-4">Venta:</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Venta.Id)</dd>
                </dl>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Volver</a>
                    <form asp-action="Delete" method="post" class="m-0">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger"><i class="fa fa-trash"></i> Eliminar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
