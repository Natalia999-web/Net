@model IEnumerable<TechNova.Models.VentaDetalle>

@{
    ViewData["Title"] = "Detalles de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Detalles de Venta</h1>

<!-- Botón Crear -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Crear Detalle</a>
</div>

<!-- Tabla de Detalles -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Cantidad)</th>
                <th>@Html.DisplayNameFor(model => model.Precio)</th>
                <th>@Html.DisplayNameFor(model => model.Subtotal)</th>
                <th>Producto</th>
                <th>Venta</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Cantidad)</td>
                    <td>@Html.DisplayFor(modelItem => item.Precio)</td>
                    <td>@Html.DisplayFor(modelItem => item.Subtotal)</td>
                    <td>@Html.DisplayFor(modelItem => item.Producto.Id)</td>
                    <td>@Html.DisplayFor(modelItem => item.Venta.Id)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm me-1">
                            <i class="fa fa-edit"></i> Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-1">
                            <i class="fa fa-eye"></i> Detalles
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-trash"></i> Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
