@model IEnumerable<TechNova.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Clientes</h1>

<!-- Botón Crear -->
<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="fa fa-plus"></i> Crear Cliente</a>
</div>

<!-- Buscador -->
<form asp-controller="Clientes" asp-action="Index" class="mb-3 d-flex align-items-center">
    <input type="text" name="buscar" class="form-control me-2" placeholder="Buscar cliente..." />
    <button type="submit" class="btn btn-secondary"><i class="fa fa-search"></i> Buscar</button>
</form>

<!-- Tabla de clientes -->
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>@Html.DisplayNameFor(model => model.NombreCompleto)</th>
                <th>@Html.DisplayNameFor(model => model.Correo)</th>
                <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.NombreCompleto)</td>
                    <td>@Html.DisplayFor(modelItem => item.Correo)</td>
                    <td>@Html.DisplayFor(modelItem => item.Direccion)</td>
                    <td>@Html.DisplayFor(modelItem => item.Telefono)</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary btn-sm me-1">
                            <i class="fa fa-edit"></i> Editar
                        </a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm me-1">
                            <i class="fa fa-eye"></i> Detalles
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-trash"></i> Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
