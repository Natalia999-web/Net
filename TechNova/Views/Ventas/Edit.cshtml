@model TechNova.Models.Venta

@{
    ViewData["Title"] = "Editar Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-primary fw-bold mb-3">Editar Venta</h1>
<hr class="border-primary" />

<div class="table-responsive mt-4">
    <table class="table table-bordered table-striped shadow-sm align-middle">
        <thead class="table-primary">
            <tr>
                <th colspan="2" class="text-center fs-5">
                    <i class="fa-solid fa-pen-to-square"></i> Modificar Información de la Venta
                </th>
            </tr>
        </thead>

        <tbody>
            <form asp-action="Edit">
                <input type="hidden" asp-for="Id" />

            <tr>
                <th style="width: 30%;">Cliente</th>
                <td>
                    <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </td>
            </tr>

            <tr>
                <th>Fecha</th>
                <td>
                    <input asp-for="Fecha" type="date" class="form-control" />
                    <span asp-validation-for="Fecha" class="text-danger"></span>
                </td>
            </tr>

            <tr>
                <th>Total</th>
                <td>
                    <input asp-for="Total" class="form-control" />
                    <span asp-validation-for="Total" class="text-danger"></span>
                </td>
            </tr>

            <tr>
                <td colspan="2" class="text-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">
                        <i class="fa fa-arrow-left"></i> Volver
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i> Guardar
                    </button>
                </td>
            </tr>
            </form>
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
