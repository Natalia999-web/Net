@model IEnumerable<TechNova.Models.Venta>

<h1 class="text-primary fw-bold mb-4">Ventas</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="fa fa-plus"></i> Crear Venta
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle shadow-sm">
        <thead class="table-primary text-center">
            <tr>
                <th>Cliente</th>
                <th>Total</th>
                <th>Fecha</th>
                <th>Productos</th>
                <th style="width: 220px;">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var venta in Model)
            {
                <tr>
                    <td>@venta.Cliente.NombreCompleto</td>

                    <td><strong>$@venta.Total.ToString("N2")</strong></td>

                    <td>@venta.Fecha.ToShortDateString()</td>

                    <td>
                        <ul class="m-0 ps-3">
                            @foreach (var det in venta.VentaDetalles)
                            {
                                <li>@det.Producto.Nombre x @det.Cantidad</li>
                            }
                        </ul>
                    </td>

                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@venta.Id"
                           class="btn btn-info btn-sm me-1">
                            <i class="fa fa-eye"></i> Detalles
                        </a>

                        <a asp-action="Edit" asp-route-id="@venta.Id"
                           class="btn btn-warning btn-sm me-1">
                            <i class="fa fa-edit"></i> Editar
                        </a>

                        <form asp-action="Delete" asp-route-id="@venta.Id"
                              method="post" class="d-inline">
                            <button type="submit" class="btn btn-danger btn-sm">
                                <i class="fa fa-trash"></i> Eliminar
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
