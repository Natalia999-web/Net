@model TechNova.Models.Venta

@{
    ViewData["Title"] = "Detalle de Venta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1 class="text-primary fw-bold mb-4">
    Detalle de Venta #@Model.Id
</h1>

<!-- DATOS GENERALES -->
<div class="card shadow-sm border-primary mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fa fa-file-invoice"></i> Información General
        </h5>
    </div>

    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <p><strong>Cliente:</strong> @Model.Cliente.NombreCompleto</p>
            </div>
            <div class="col-md-6">
                <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
            </div>
        </div>
    </div>
</div>

<!-- PRODUCTOS -->
<div class="card shadow-sm border-primary">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            <i class="fa fa-box"></i> Productos Vendidos
        </h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle">
                <thead class="table-primary text-center">
                    <tr>
                        <th>Producto</th>
                        <th style="width:120px;">Cantidad</th>
                        <th style="width:160px;">Precio Unitario</th>
                        <th style="width:160px;">Subtotal</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var detalle in Model.VentaDetalles)
                    {
                        <tr>
                            <td>@detalle.Producto.Nombre</td>
                            <td class="text-center">@detalle.Cantidad</td>
                            <td class="text-end">$@detalle.Precio.ToString("N2")</td>
                            <td class="text-end fw-semibold">$@detalle.Subtotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>

                <tfoot class="table-light">
                    <tr>
                        <th colspan="3" class="text-end fs-5">Total</th>
                        <th class="text-end fs-5 text-primary">
                            $@Model.Total.ToString("N2")
                        </th>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="mt-4 text-end">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fa fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>
