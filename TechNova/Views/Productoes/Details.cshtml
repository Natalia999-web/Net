@model TechNova.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Detalles del Producto</h1>
<hr />

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Nombre)</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Descripcion)</dd>

                    <dt class="col-sm-4">Precio Unitario</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Precio)</dd>

                    <dt class="col-sm-4">Stock</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Stock)</dd>

                    <dt class="col-sm-4">Código</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Codigo)</dd>
                </dl>

                <div class="d-flex justify-content-between mt-3">
                    <a asp-action="Index" class="btn btn-secondary"><i class="fa fa-arrow-left"></i> Volver</a>
                    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary"><i class="fa fa-edit"></i> Editar</a>
                </div>
            </div>
        </div>
    </div>
</div>
